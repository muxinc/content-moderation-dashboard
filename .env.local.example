# Automatically set by `npx convex dev` during local development
# and by the Convex Vercel integration in production
NEXT_PUBLIC_CONVEX_URL=

# Admin password for the dashboard login screen
# Set this to any value to enable password protection
ADMIN_PASSWORD=

# Mux credentials — set these as Convex environment variables, not here:
#   npx convex env set MUX_TOKEN_ID <your-mux-token-id>
#   npx convex env set MUX_TOKEN_SECRET <your-mux-token-secret>
#   npx convex env set MUX_WEBHOOK_SECRET <your-webhook-signing-secret>
#
# In production (Vercel), set MUX_TOKEN_ID, MUX_TOKEN_SECRET, and
# MUX_WEBHOOK_SECRET as Vercel environment variables — they are
# automatically pushed to Convex during every build.
